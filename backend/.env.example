# Copy this file to .env and fill in the values. Never commit .env.

# Signs login tokens. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# The OAuth client ID from Google Cloud Console (ends in .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=

# Comma-separated list of frontend addresses allowed to call this API
FRONTEND_ORIGINS=http://localhost:8080

# PostgreSQL connection: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=
